<div class="devise-page">
  <div class="auth-card">

    <p class="auth-label">SIGN UP</p>
    <h2 class="auth-title">新規登録</h2>
    <p class="auth-lead">アカウントを作ると、曲の投稿といいねができます。</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <!--サインアップ時に名前を入力できるようにフォームを追加-->
      <div class="field">
        <%= f.label :name, "ユーザー名", class: "field-label" %>
        <%= f.text_field :name, autofocus: true, class: "field-input" %>
        <p class="field-hint">投稿した曲に表示される名前です</p>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス", class: "field-label" %>
        <%= f.email_field :email, autocomplete: "email", class: "field-input" %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード", class: "field-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "field-input" %>
        <% if @minimum_password_length %>
          <p class="field-hint"><%= @minimum_password_length %>文字以上で入力してください</p>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード（確認）", class: "field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
      </div>

      <div class="actions">
        <%= f.submit "登録する", class: "btn btn-primary" %>
      </div>
    <% end %>

    <%= render "users/shared/links" %>

  </div>
</div>