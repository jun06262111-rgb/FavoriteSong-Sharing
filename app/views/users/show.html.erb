<h1><%= @user.name %>さんのページ</h1>

<p>メールアドレス : <%= @user.email %></p>
<p>プロフィール : <%= @user.profile %></p>

<% if current_user.id == @user.id %>
  <%= link_to "編集する", edit_user_registration_path %>
<% end %>

<h2>ユーザーの投稿一覧（<%= @user.tweets.count %>件）</h2>

<% if @user.tweets.present? %>
  <ul>
    <% @user.tweets.order(created_at: :desc).each do |t| %>
      <li>
        <%= link_to t.music_name, tweet_path(t) %>
        ／ <%= t.music_artist %>
        ／ おすすめ度 <%= t.favorite_point %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだ曲を投稿していません。</p>
<% end %>

<h2>いいねした投稿一覧（<%= @user.liked_tweets.count %>件）</h2>

<% if @user.liked_tweets.present? %>
  <ul>
    <% @user.liked_tweets.each do |t| %>
      <li>
        <%= link_to t.music_name, tweet_path(t) %>
        ／ <%= t.music_artist %>
        ／ by <%= t.user.name %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだいいねした投稿がありません。</p>
<% end %>

<% if current_user.id == @user.id %>
  <p><%= link_to "新しく曲を投稿する", new_tweet_path %></p>
<% end %>

<p><%= link_to "曲の一覧に戻る", tweets_path %></p>