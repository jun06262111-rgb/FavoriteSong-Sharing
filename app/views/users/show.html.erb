<div class="users-show-page">
  <div class="page-inner">

    <header class="page-head">
      <%= link_to "← 曲の一覧に戻る", tweets_path, class: "back-link" %>
      <h1 class="page-title"><%= @user.name %>さんのページ</h1>
    </header>

    <div class="page-columns">

      <div class="col-side">
        <section class="panel profile-card">
          <p class="profile-avatar" aria-hidden="true"><%= @user.name.to_s.first %></p>
          <p class="profile-name"><%= @user.name %></p>

          <dl class="profile-detail">
            <div class="detail-row">
              <dt class="detail-label">メールアドレス</dt>
              <dd class="detail-value"><%= @user.email %></dd>
            </div>

            <div class="detail-row">
              <dt class="detail-label">プロフィール</dt>
              <dd class="detail-value detail-body"><%= @user.profile %></dd>
            </div>
          </dl>

          <p class="profile-stats">
            <span class="stat">
              <span class="stat-num"><%= @user.tweets.count %></span>
              <span class="stat-label">投稿</span>
            </span>
            <span class="stat">
              <span class="stat-num"><%= @user.liked_tweets.count %></span>
              <span class="stat-label">いいね</span>
            </span>
          </p>

          <% if current_user&.id == @user.id %>
            <div class="profile-actions">
              <%= link_to "新しく曲を投稿する", new_tweet_path, class: "btn btn-primary" %>
              <%= link_to "プロフィールを編集する", edit_user_registration_path, class: "btn btn-outline" %>
            </div>
          <% end %>
        </section>
      </div>

      <div class="col-main">

        <section class="panel">
          <h2 class="section-title">
            ユーザーの投稿一覧
            <span class="section-count"><%= @user.tweets.count %>件</span>
          </h2>

          <% if @user.tweets.present? %>
            <ul class="song-list">
              <% @user.tweets.order(created_at: :desc).each do |t| %>
                <li class="song-item">
                  <%= link_to t.music_name, tweet_path(t), class: "song-name" %>
                  <p class="song-sub">
                    <span class="song-artist"><%= t.music_artist %></span>
                    <span class="song-point">おすすめ度 <%= t.favorite_point %></span>
                  </p>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="empty">まだ曲を投稿していません。</p>
          <% end %>
        </section>

        <section class="panel">
          <h2 class="section-title">
            いいねした投稿一覧
            <span class="section-count"><%= @user.liked_tweets.count %>件</span>
          </h2>

          <% if @user.liked_tweets.present? %>
            <ul class="song-list">
              <% @user.liked_tweets.each do |t| %>
                <li class="song-item">
                  <%= link_to t.music_name, tweet_path(t), class: "song-name" %>
                  <p class="song-sub">
                    <span class="song-artist"><%= t.music_artist %></span>
                    <span class="song-user">by <%= t.user.name %></span>
                  </p>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="empty">まだいいねした投稿がありません。</p>
          <% end %>
        </section>

      </div>

    </div>
  </div>
</div>