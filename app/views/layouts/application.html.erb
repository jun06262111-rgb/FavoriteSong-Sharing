<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Favorite" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/1c6b906551.js" crossorigin="anonymous"></script>
    
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="site-brand">
          <h1 class="site-logo">
            <%= link_to root_path, class: "site-logo-link" do %>
              <span class="site-logo-mark" aria-hidden="true"></span>
              <span class="site-logo-text">楽曲紹介サイト</span>
            <% end %>
          </h1>
          <p class="site-tagline">〜まだ知らない一曲に、今日出会う。〜</p>
        </div>

        <div class="header-list">
          <ul class="header-nav">
            <li class="nav-group">
              <%= link_to "曲の一覧", tweets_path, class: "nav-link #{'is-current' if controller_name == 'tweets' && action_name == 'index'}" %>
              <% if user_signed_in? %>
                <%= link_to "曲を投稿する", new_tweet_path, class: "nav-link #{'is-current' if controller_name == 'tweets' && action_name == 'new'}" %>
              <% end %>
            </li>

            <li class="nav-divider" aria-hidden="true"></li>

            <li class="nav-group nav-group-account">
              <% if user_signed_in? %>
                <%= link_to "マイページ", user_path(current_user), class: "nav-link nav-link-quiet #{'is-current' if controller_name == 'users' && action_name == 'show'}" %>
                <%= button_to 'ログアウト', destroy_user_session_path, method: :delete, class: "nav-link nav-link-quiet nav-button", form_class: "nav-form" %>
              <% else %>
                <%= link_to "ログイン", new_user_session_path, class: "nav-link nav-link-quiet #{'is-current' if controller_name == 'sessions'}" %>
                <%= link_to "新規登録", new_user_registration_path, class: "nav-link nav-link-quiet #{'is-current' if controller_name == 'registrations' && action_name == 'new'}" %>
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="flash-area">
        <% if notice.present? %>
          <p class="flash flash-notice"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="flash flash-alert"><%= alert %></p>
        <% end %>
      </div>
    <% end %>

    <main class="site-main">
      <%= yield %>
    </main>
  </body>
</html>