<div class="tweets-form-page">
  <div class="page-inner">

    <header class="page-head">
      <%= link_to "← 一覧に戻る", tweets_path, class: "back-link" %>
      <h1 class="page-title">(自分の題名)</h1>
      <h3 class="page-subtitle">新規投稿ページ</h3>
    </header>

    <%= form_for @tweet, html: { class: "tweet-form" } do |f| %>

      <% if @tweet.errors.any? %>
        <div class="form-errors">
          <p class="form-errors-title"><%= @tweet.errors.count %>件の入力エラーがあります</p>
          <ul class="form-errors-list">
            <% @tweet.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <section class="form-section">
        <h2 class="section-title">曲の基本情報</h2>

        <div class="field-grid">
          <div class="field">
            <%= f.label :曲のタイトル, class: "field-label" %>
            <%= f.text_field :music_name, :size => 30, class: "field-input" %>
          </div>

          <div class="field">
            <%= f.label :アーティストの名前, class: "field-label" %>
            <%= f.text_field :music_artist, :size => 30, class: "field-input" %>
          </div>

          <div class="field">
            <%= f.label :発売年, class: "field-label" %>
            <%= f.number_field :music_year, :size => 10, class: "field-input" %>
          </div>

          <%# 左：画面表示　右：テーブルに保存される形式。一緒にする %>
          <div class="field">
            <%= f.label :アーティストのジャンル, class: "field-label" %>
            <%= f.select :music_genre,
            [
            ["J-pop", "J-pop"],
            ["邦ロック", "邦ロック"],
            ["邦楽ヒップホップ/R&B/レゲエ", "邦楽ヒップホップ/R&B/レゲエ"],
            ["アニメ", "アニメ"],
            ["ボカロ", "ボカロ"],
            ["K-pop", "K-pop"],
            ["洋楽", "洋楽"],
            ["その他","その他"]
            ], { include_blank: "一番近いジャンルを選択して下さい" }, { class: "field-select" } %>
          </div>
        </div>
      </section>

      <section class="form-section">
        <h2 class="section-title">おすすめポイント</h2>

        <div class="field field-narrow">
          <%= f.label :おすすめ度, class: "field-label" %>
          <%= f.number_field :favorite_point, min: 1, max: 5, step: 0.1, class: "field-input" %>
          <p class="field-hint">1.0 〜 5.0 の範囲で入力してください</p>
        </div>

        <div class="field">
          <%= f.label :"おすすめポイント(感想・曲全体)", class: "field-label" %>
          <%= f.text_area :review, :size => "30x2", class: "field-textarea", rows: 4 %>
        </div>

        <div class="field">
          <%= f.label :おすすめフレーズ, class: "field-label" %>
          <%= f.text_area :favorite_phrase, :size => "30x2", class: "field-textarea", rows: 3 %>
        </div>

        <div class="field field-narrow">
          <%= f.label :タイムスタンプ, class: "field-label" %>
          <%= f.text_field :favorite_time, :size => 30, class: "field-input" %>
          <p class="field-hint">例：1:24 のように、特に好きな箇所の時間</p>
        </div>
      </section>

      <section class="form-section">
        <h2 class="section-title">リンク</h2>

        <div class="field">
          <%= f.label :youtubeのurl, class: "field-label" %>
          <%= f.text_field :youtube_url, :size => 30, class: "field-input" %>
          <p class="field-hint">詳細ページでプレイヤーとして埋め込まれます</p>
        </div>

        <div class="field">
          <%= f.label :MVのURL, class: "field-label" %>
          <%= f.text_field :mv_url, :size => 30, class: "field-input" %>
        </div>

        <div class="field">
          <%= f.label :AppleMusicの埋め込みリンク, class: "field-label" %>
          <%= f.text_field :music_url, :size => 30, class: "field-input" %>
        </div>

        <div class="field">
          <%= f.label :apple, "AppleMusic埋め込みリンク(新)", class: "field-label" %>
          <%= f.text_field :apple, :size => 30, class: "field-input" %>
        </div>
      </section>

      <div class="form-actions">
        <%= f.submit "投稿する", class: "btn btn-primary" %>
        <%= link_to "一覧に戻る", tweets_path, class: "btn btn-outline" %>
      </div>

    <% end %>

  </div>
</div>