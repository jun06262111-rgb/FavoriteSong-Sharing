<div class="tweets-form-page">
  <div class="page-inner">

    <header class="page-head">
      <%= link_to "← 一覧に戻る", tweets_path, class: "back-link" %>
      <p class="page-label">NEW POST</p>
      <h1 class="page-title">あなたの「これを聴いてほしい」を<br class="title-br">教えてください。</h1>
      <p class="page-lead">まだその曲を知らない誰かが、ここから出会います。うまく書こうとしなくて大丈夫です。</p>
    </header>

    <%= form_for @tweet, html: { class: "tweet-form" } do |f| %>

      <% if @tweet.errors.any? %>
        <div class="form-errors">
          <p class="form-errors-title"><%= @tweet.errors.count %>件の入力エラーがあります</p>
          <ul class="form-errors-list">
            <% @tweet.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <section class="form-section">
        <h2 class="section-title">曲の基本情報</h2>

        <div class="field-grid">
          <div class="field">
            <%= f.label :music_name, class: "field-label" do %>
              曲のタイトル<span class="badge-required">必須</span>
            <% end %>
            <%= f.text_field :music_name, class: "field-input", placeholder: "空も飛べるはず", required: true %>
          </div>

          <div class="field">
            <%= f.label :music_artist, class: "field-label" do %>
              アーティストの名前<span class="badge-required">必須</span>
            <% end %>
            <%= f.text_field :music_artist, class: "field-input", placeholder: "スピッツ", required: true %>
          </div>

          <div class="field">
            <%= f.label :music_year, class: "field-label" do %>
              発売年<span class="badge-required">必須</span>
            <% end %>
            <%= f.number_field :music_year, class: "field-input", placeholder: "1996", required: true %>
          </div>

          <%# 左：画面表示　右：テーブルに保存される形式。一緒にする %>
          <div class="field">
            <%= f.label :music_genre, class: "field-label" do %>
              アーティストのジャンル<span class="badge-required">必須</span>
            <% end %>
            <%= f.select :music_genre,
            [
            ["J-pop", "J-pop"],
            ["邦ロック", "邦ロック"],
            ["邦楽ヒップホップ/R&B/レゲエ", "邦楽ヒップホップ/R&B/レゲエ"],
            ["アニメ", "アニメ"],
            ["ボカロ", "ボカロ"],
            ["K-pop", "K-pop"],
            ["洋楽", "洋楽"],
            ["その他","その他"]
            ], { include_blank: "一番近いジャンルを選択して下さい" }, { class: "field-select", required: true } %>
          </div>
        </div>
      </section>

      <section class="form-section">
        <h2 class="section-title">おすすめポイント</h2>

        <div class="field field-narrow">
          <%= f.label :favorite_point, class: "field-label" do %>
            おすすめ度<span class="badge-required">必須</span>
          <% end %>
          <%= f.number_field :favorite_point, min: 1, max: 5, step: 0.1, class: "field-input", placeholder: "4.5", required: true %>
          <p class="field-hint">1.0 〜 5.0 の範囲で入力してください</p>
        </div>

        <div class="field">
          <%= f.label :review, class: "field-label" do %>
            おすすめポイント(感想・曲全体)<span class="badge-required">必須</span>
          <% end %>
          <%= f.text_area :review, class: "field-textarea", rows: 4, placeholder: "イントロのギターが鳴った瞬間、季節が変わる感じがします。何度も聴いているのに、サビで毎回ハッとする曲です。", required: true %>
        </div>

        <div class="field">
          <%= f.label :favorite_phrase, class: "field-label" do %>
            おすすめフレーズ<span class="badge-required">必須</span>
          <% end %>
          <%= f.text_area :favorite_phrase, class: "field-textarea", rows: 3, placeholder: "特に好きな歌詞のフレーズを書いてください", required: true %>
        </div>

        <div class="field field-narrow">
          <%= f.label :favorite_time, class: "field-label" do %>
            タイムスタンプ<span class="badge-optional">任意</span>
          <% end %>
          <%= f.text_field :favorite_time, class: "field-input", placeholder: "1:24" %>
          <p class="field-hint">特に好きな箇所の時間を入力してください</p>
        </div>
      </section>

      <section class="form-section">
        <h2 class="section-title">リンク</h2>

        <div class="field">
          <%= f.label :youtube_url, class: "field-label" do %>
            YouTube の MV リンク<span class="badge-required">必須</span>
          <% end %>
          <%= f.text_field :youtube_url, class: "field-input", placeholder: "https://www.youtube.com/watch?v=xxxxxxxxxxx", required: true %>
          <p class="field-hint">詳細ページでプレイヤーとして埋め込まれます</p>
        </div>

        <div class="field">
          <%= f.label :music_url, class: "field-label" do %>
            音楽アプリのリンク<span class="badge-optional">任意</span>
          <% end %>
          <%= f.text_field :music_url, class: "field-input", placeholder: "https://music.apple.com/jp/album/..." %>
          <p class="field-hint">Apple Music や Spotify など、聴けるページのURL</p>
        </div>

        <%# mv_url と apple は使用しないため非表示 %>
      </section>

      <div class="form-actions">
        <%= f.submit "投稿する", class: "btn btn-primary" %>
        <%= link_to "一覧に戻る", tweets_path, class: "btn btn-outline" %>
      </div>

    <% end %>

  </div>
</div>